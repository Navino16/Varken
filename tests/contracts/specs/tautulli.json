{
  "openapi": "3.1.0",
  "info": {
    "title": "Tautulli API v2 (Varken contract)",
    "version": "v2.19.1",
    "description": "Hand-written from the @addtoapi docstrings of plexpy/webserve.py (the source of the wiki API reference) and checked against Tautulli's source, linked from each corrected schema. Only the commands Varken calls. Every command is a fixed query string on /api/v2."
  },
  "paths": {
    "/api/v2?cmd=get_activity": {
      "get": {
        "summary": "Get the current activity on the PMS. session_key/session_id are not declared: they return a single session instead.",
        "parameters": [
          {
            "name": "apikey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API key; the X-Api-Key header alternative only exists since v2.18.0 (https://github.com/Tautulli/Tautulli/blob/v2.19.1/plexpy/api2.py#L106)"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2?cmd=get_geoip_lookup": {
      "get": {
        "summary": "Get the geolocation info for an IP address.",
        "parameters": [
          {
            "name": "apikey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API key; the X-Api-Key header alternative only exists since v2.18.0 (https://github.com/Tautulli/Tautulli/blob/v2.19.1/plexpy/api2.py#L106)"
          },
          {
            "name": "ip_address",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoIpResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2?cmd=get_libraries": {
      "get": {
        "summary": "Get a list of all libraries on your server.",
        "parameters": [
          {
            "name": "apikey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API key; the X-Api-Key header alternative only exists since v2.18.0 (https://github.com/Tautulli/Tautulli/blob/v2.19.1/plexpy/api2.py#L106)"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibrariesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2?cmd=get_server_info": {
      "get": {
        "summary": "Get the PMS server information.",
        "parameters": [
          {
            "name": "apikey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API key; the X-Api-Key header alternative only exists since v2.18.0 (https://github.com/Tautulli/Tautulli/blob/v2.19.1/plexpy/api2.py#L106)"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerInfoResponse"
                }
              }
            }
          }
        }
      }
    }
  },
