{
  "bazarr": {
    "file": "bazarr.json",
    "format": "swagger2",
    "pathPrefix": "/api",
    "refresh": {
      "image": "lscr.io/linuxserver/bazarr:{tag}",
      "kind": "runtime",
      "path": "/api/swagger.json",
      "port": 6767,
      "repo": "linuxserver/docker-bazarr"
    },
    "source": "runtime:/api/swagger.json (lscr.io/linuxserver/bazarr:{tag})",
    "version": "v1.6.2-ls373"
  },
  "emby": {
    "file": "emby.json",
    "format": "openapi3.0",
    "pathPrefix": "/emby",
    "refresh": {
      "image": "emby/embyserver:{tag}",
      "kind": "runtime",
      "path": "/emby/openapi.json",
      "port": 8096,
      "repo": "MediaBrowser/Emby.Releases"
    },
    "source": "runtime:/emby/openapi.json (emby/embyserver:{tag})",
    "version": "4.10.2.0"
  },
  "jellyfin": {
