{
  "patches": [
    {
      "op": "add",
      "path": "/paths/~1library~1sections~1{sectionId}~1all/get/parameters/-",
      "value": {
        "name": "X-Plex-Container-Start",
        "in": "header",
        "required": false,
        "description": "The desired starting offset",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "why": "https://developer.plex.tv/pms/#section/API-Info/Pagination — the spec's own info.description: pagination is requested with the X-Plex-Container-Start and X-Plex-Container-Size headers, and a size of 0 returns only the total size"
    },
    {
      "op": "add",
      "path": "/paths/~1library~1sections~1{sectionId}~1all/get/parameters/-",
      "value": {
        "name": "X-Plex-Container-Size",
        "in": "header",
        "required": false,
        "description": "The desired number of items",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "why": "https://developer.plex.tv/pms/#section/API-Info/Pagination — the spec's own info.description: pagination is requested with the X-Plex-Container-Start and X-Plex-Container-Size headers, and a size of 0 returns only the total size"
    },
    {
      "op": "add",
      "path": "/paths/~1status~1sessions/get/responses/200/content/application~1json/schema/properties/MediaContainer/allOf/1/properties/Metadata/items/allOf/0/properties/sessionKey",
      "value": {
        "type": [
          "string",
          "integer"
