{
  "__inputs": [
    {
      "name": "DS_VARKEN",
      "label": "Varken (InfluxDB 1)",
      "description": "",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "influxdb",
      "name": "InfluxDB",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "table",
      "version": ""
    }
  ],
  "uid": "varken-overview-influxdb1",
  "title": "Varken Overview",
  "description": "Generated by Varken 9.9.9",
  "tags": [
    "varken"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Downloads",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_VARKEN}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Sonarr 1",
          "query": "SELECT last(\"size\") AS \"size\" FROM (SELECT count(\"size\") AS \"size\" FROM \"Sonarr\" WHERE \"type\" = 'Queue' AND \"server\" = '1' AND time > now() - 90s GROUP BY time(30s) fill(none))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Stuck downloads",
      "gridPos": {
        "x": 3,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_VARKEN}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Sonarr 1",
          "query": "SELECT last(\"size\") AS \"size\" FROM (SELECT count(\"size\") AS \"size\" FROM \"Sonarr\" WHERE \"type\" = 'Queue' AND \"server\" = '1' AND \"tracked_download_status\" != 'ok' AND time > now() - 90s GROUP BY time(30s) fill(none))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    },
    {
      "id": 4,
      "type": "table",
      "title": "Download queue",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_VARKEN}"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT last(\"progress\") AS \"progress\", last(\"sizeleft\") AS \"sizeleft\" FROM \"Sonarr\" WHERE \"type\" = 'Queue' AND \"server\" = '1' AND time > now() - 30s GROUP BY \"name\", \"sxe\", \"tracked_download_status\""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Progress"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Left"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "name": 0,
              "sxe": 1,
              "tracked_download_status": 2,
              "progress": 3,
              "sizeleft": 4
            },
            "renameByName": {
              "name": "Title",
              "sxe": "Episode",
              "tracked_download_status": "Status",
              "progress": "Progress",
              "sizeleft": "Left"
            }
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    }
  ]
}
