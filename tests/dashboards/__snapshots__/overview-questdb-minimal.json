{
  "__inputs": [
    {
      "name": "DS_VARKEN",
      "label": "Varken (QuestDB)",
      "description": "",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "table",
      "version": ""
    }
  ],
  "uid": "varken-overview-questdb",
  "title": "Varken Overview",
  "description": "Generated by Varken 9.9.9",
  "tags": [
    "varken"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Downloads",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_VARKEN}"
          },
          "rawSql": "SELECT timestamp_floor('30s', timestamp) AS time, 'Sonarr 1' AS metric, count(\"size\") AS value FROM \"Sonarr\" WHERE \"type\" = 'Queue' AND \"server\" = '1' AND timestamp > dateadd('s', -90, now()) GROUP BY 1 ORDER BY time",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Stuck downloads",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_VARKEN}"
          },
          "rawSql": "SELECT timestamp_floor('30s', timestamp) AS time, 'Sonarr 1' AS metric, count(\"size\") AS value FROM \"Sonarr\" WHERE \"type\" = 'Queue' AND \"server\" = '1' AND (\"tracked_download_status\" != 'ok' OR \"tracked_download_status\" IS NULL) AND (\"tracked_download_status\" != 'unknown' OR \"tracked_download_status\" IS NULL) AND timestamp > dateadd('s', -90, now()) GROUP BY 1 ORDER BY time",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    },
    {
      "id": 4,
      "type": "table",
      "title": "Download queue",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_VARKEN}"
          },
          "rawSql": "SELECT \"name\" AS \"name\", \"sxe\" AS \"sxe\", \"tracked_download_status\" AS \"tracked_download_status\", last(\"progress\") AS \"progress\", last(\"sizeleft\") AS \"sizeleft\" FROM \"Sonarr\" WHERE \"type\" = 'Queue' AND \"server\" = '1' AND timestamp > dateadd('s', -60, now()) GROUP BY \"name\", \"sxe\", \"tracked_download_status\"",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Progress"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Left"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "name": 0,
              "sxe": 1,
              "tracked_download_status": 2,
              "progress": 3,
              "sizeleft": 4
            },
            "renameByName": {
              "name": "Title",
              "sxe": "Episode",
              "tracked_download_status": "Status",
              "progress": "Progress",
              "sizeleft": "Left"
            }
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    }
  ]
}
