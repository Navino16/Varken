{
  "__inputs": [
    {
      "name": "DS_VARKEN",
      "label": "Varken (VictoriaMetrics)",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "table",
      "version": ""
    }
  ],
  "uid": "varken-overview-victoriametrics",
  "title": "Varken Overview",
  "description": "Generated by Varken 9.9.9",
  "tags": [
    "varken"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Downloads",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VARKEN}"
          },
          "expr": "label_set(last_over_time((sum(count_over_time(Sonarr_size{type=\"Queue\", server=\"1\"}[30s])))[90s:30s]), \"__name__\", \"size\")",
          "legendFormat": "Sonarr 1",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Stuck downloads",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VARKEN}"
          },
          "expr": "label_set(last_over_time((sum(count_over_time(Sonarr_size{type=\"Queue\", server=\"1\", tracked_download_status!=\"ok\", tracked_download_status!=\"unknown\"}[30s])))[90s:30s]), \"__name__\", \"size\")",
          "legendFormat": "Sonarr 1",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    },
    {
      "id": 4,
      "type": "table",
      "title": "Download queue",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VARKEN}"
          },
          "expr": "union(label_set(max by (name, sxe, tracked_download_status) (last_over_time(Sonarr_progress{type=\"Queue\", server=\"1\"}[60s])), \"__name__\", \"progress\", \"varken_source\", \"Sonarr 1\"), label_set(max by (name, sxe, tracked_download_status) (last_over_time(Sonarr_sizeleft{type=\"Queue\", server=\"1\"}[60s])), \"__name__\", \"sizeleft\", \"varken_source\", \"Sonarr 1\"))",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Progress"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Left"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "joinByLabels",
          "options": {
            "value": "__name__"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "varken_source": true
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "name": 0,
              "sxe": 1,
              "tracked_download_status": 2,
              "progress": 3,
              "sizeleft": 4
            },
            "renameByName": {
              "name": "Title",
              "sxe": "Episode",
              "tracked_download_status": "Status",
              "progress": "Progress",
              "sizeleft": "Left"
            }
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    }
  ]
}
