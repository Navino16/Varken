{
  "__inputs": [
    {
      "name": "DS_VARKEN",
      "label": "Varken (TimescaleDB)",
      "description": "",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "table",
      "version": ""
    }
  ],
  "uid": "varken-overview-timescaledb",
  "title": "Varken Overview",
  "description": "Generated by Varken 9.9.9",
  "tags": [
    "varken"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Downloads",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_VARKEN}"
          },
          "rawSql": "SELECT time_bucket('30s', time) AS time, 'Sonarr 1' AS metric, count((fields->>'size')::double precision) AS value FROM varken_events WHERE measurement = 'Sonarr' AND tags->>'type' = 'Queue' AND tags->>'server' = '1' AND time > now() - interval '90 seconds' GROUP BY 1 ORDER BY time",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Stuck downloads",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_VARKEN}"
          },
          "rawSql": "SELECT time_bucket('30s', time) AS time, 'Sonarr 1' AS metric, count((fields->>'size')::double precision) AS value FROM varken_events WHERE measurement = 'Sonarr' AND tags->>'type' = 'Queue' AND tags->>'server' = '1' AND tags->>'tracked_download_status' IS DISTINCT FROM 'ok' AND tags->>'tracked_download_status' IS DISTINCT FROM 'unknown' AND time > now() - interval '90 seconds' GROUP BY 1 ORDER BY time",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    },
    {
      "id": 4,
      "type": "table",
      "title": "Download queue",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_VARKEN}"
          },
          "rawSql": "SELECT tags->>'name' AS \"name\", tags->>'sxe' AS \"sxe\", tags->>'tracked_download_status' AS \"tracked_download_status\", last((fields->>'progress')::double precision, time) AS \"progress\", last((fields->>'sizeleft')::double precision, time) AS \"sizeleft\" FROM varken_events WHERE measurement = 'Sonarr' AND tags->>'type' = 'Queue' AND tags->>'server' = '1' AND time > now() - interval '60 seconds' GROUP BY tags->>'name', tags->>'sxe', tags->>'tracked_download_status'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Progress"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Left"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "name": 0,
              "sxe": 1,
              "tracked_download_status": 2,
              "progress": 3,
              "sizeleft": 4
            },
            "renameByName": {
              "name": "Title",
              "sxe": "Episode",
              "tracked_download_status": "Status",
              "progress": "Progress",
              "sizeleft": "Left"
            }
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    }
  ]
}
