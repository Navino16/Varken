{
  "__inputs": [
    {
      "name": "DS_VARKEN",
      "label": "Varken (InfluxDB 2, Flux)",
      "description": "",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "influxdb",
      "name": "InfluxDB",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "table",
      "version": ""
    }
  ],
  "uid": "varken-overview-influxdb2",
  "title": "Varken Overview",
  "description": "Generated by Varken 9.9.9",
  "tags": [
    "varken"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Downloads",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_VARKEN}"
          },
          "query": "data = from(bucket: v.defaultBucket)\n  |> range(start: -90s)\n  |> filter(fn: (r) => r._measurement == \"Sonarr\" and r[\"type\"] == \"Queue\" and r[\"server\"] == \"1\" and (r._field == \"size\"))\nf0 = data\n  |> filter(fn: (r) => r._field == \"size\")\n  |> group(columns: [\"_field\"])\n  |> sort(columns: [\"_time\"])\n  |> aggregateWindow(every: 30s, fn: count, createEmpty: false)\n  |> toFloat()\n  |> map(fn: (r) => ({ r with _field: \"Sonarr 1\" }))\nf0\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> rename(columns: {_time: \"Time\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Stuck downloads",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_VARKEN}"
          },
          "query": "data = from(bucket: v.defaultBucket)\n  |> range(start: -90s)\n  |> filter(fn: (r) => r._measurement == \"Sonarr\" and r[\"type\"] == \"Queue\" and r[\"server\"] == \"1\" and (not exists r[\"tracked_download_status\"] or r[\"tracked_download_status\"] != \"ok\") and (not exists r[\"tracked_download_status\"] or r[\"tracked_download_status\"] != \"unknown\") and (r._field == \"size\"))\nf0 = data\n  |> filter(fn: (r) => r._field == \"size\")\n  |> group(columns: [\"_field\"])\n  |> sort(columns: [\"_time\"])\n  |> aggregateWindow(every: 30s, fn: count, createEmpty: false)\n  |> toFloat()\n  |> map(fn: (r) => ({ r with _field: \"Sonarr 1\" }))\nf0\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> rename(columns: {_time: \"Time\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    },
    {
      "id": 4,
      "type": "table",
      "title": "Download queue",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_VARKEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_VARKEN}"
          },
          "query": "data = from(bucket: v.defaultBucket)\n  |> range(start: -60s)\n  |> filter(fn: (r) => r._measurement == \"Sonarr\" and r[\"type\"] == \"Queue\" and r[\"server\"] == \"1\" and (r._field == \"progress\" or r._field == \"sizeleft\"))\nf0 = data\n  |> filter(fn: (r) => r._field == \"progress\")\n  |> group(columns: [\"name\", \"sxe\", \"tracked_download_status\", \"_field\", \"_start\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> toFloat()\n  |> map(fn: (r) => ({ r with _field: \"progress\" }))\nf1 = data\n  |> filter(fn: (r) => r._field == \"sizeleft\")\n  |> group(columns: [\"name\", \"sxe\", \"tracked_download_status\", \"_field\", \"_start\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> toFloat()\n  |> map(fn: (r) => ({ r with _field: \"sizeleft\" }))\nunion(tables: [f0, f1])\n  |> group(columns: [\"name\", \"sxe\", \"tracked_download_status\", \"_start\"])\n  |> pivot(rowKey: [\"name\", \"sxe\", \"tracked_download_status\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"name\", \"sxe\", \"tracked_download_status\", \"progress\", \"sizeleft\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Progress"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Left"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "name": 0,
              "sxe": 1,
              "tracked_download_status": 2,
              "progress": 3,
              "sizeleft": 4
            },
            "renameByName": {
              "name": "Title",
              "sxe": "Episode",
              "tracked_download_status": "Status",
              "progress": "Progress",
              "sizeleft": "Left"
            }
          }
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    }
  ]
}
